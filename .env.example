# All values are optional. Dev Cockpit works with none of them set.

# Where the SQLite database, artifacts and run worktrees live.
# Defaults to ./data
# DEV_COCKPIT_DATA_DIR=E:\dev-cockpit-data

# Path to the Claude Code executable. Defaults to "claude" on PATH.
# DEV_COCKPIT_CLAUDE_BIN=claude

# Optional third CLI agent for any Engineering team role, including Engineer.
# Install @google/gemini-cli and run gemini once to sign in with Google.
# Uses cached CLI OAuth, not Gemini API keys or Vertex credentials.
# DEV_COCKPIT_GEMINI_BIN=gemini

# Turns off the retention sweep that reclaims finished runs' worktrees and
# artifact bytes. Retention windows are per project; this disables the sweep
# entirely, so nothing is reclaimed until it is switched back on.
# DEV_COCKPIT_DISABLE_EXPIRY=1
